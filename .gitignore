data/raw/*.csv
data/raw/*.json
data/raw/*.jsonl
# data/sample/ 下的小样本可入仓,不忽略

# ============================================================
# 密钥/环境变量 (LLM API key 必须放 .env)
# ============================================================
.env
.env.*
!.env.example

